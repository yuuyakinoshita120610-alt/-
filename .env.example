# Copy to .env.local; never commit real credentials.
OPENAI_API_KEY=
# Explicitly enable after configuration. Set false and redeploy to stop new calls.
AI_ENABLED=false

# Required with NODE_ENV=production (including next start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret, at least 32 characters. Keep stable across all instances.
RATE_LIMIT_SALT=
# All instances of the same environment must share this namespace/database.
RATE_LIMIT_NAMESPACE=rakuracook

# Shared across analyze + recipes. Each admitted attempt counts, even on failure.
AI_DAILY_CALL_LIMIT=100
AI_CLIENT_MINUTE_LIMIT=5
AI_MAX_CONCURRENT=3

# Optional. Set ONLY to a single-IP header overwritten by a trusted reverse proxy.
# Ensure clients cannot bypass that proxy. Empty = all visitors share one bucket.
TRUSTED_IP_HEADER=
